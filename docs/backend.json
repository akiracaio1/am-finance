
{
  "entities": {
    "Supplier": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Supplier",
      "type": "object",
      "description": "Represents a vendor or supplier with whom the business conducts transactions.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "personType": { "type": "string", "enum": ["Pessoa Física", "Pessoa Jurídica"] },
        "pixKey": { "type": "string" },
        "cnpj": { "type": "string" },
        "contactName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "category": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "personType", "createdAt", "updatedAt"]
    },
    "AccountCategory": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AccountCategory",
      "type": "object",
      "description": "Defines a category within the chart of accounts.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string" },
        "code": { "type": "string" },
        "parentCategoryId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "type", "createdAt", "updatedAt"]
    },
    "CostCenter": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CostCenter",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "createdAt", "updatedAt"]
    },
    "AccountsPayableEntry": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AccountsPayableEntry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "supplierId": { "type": "string" },
        "accountCategoryId": { "type": "string" },
        "costCenterId": { "type": "string" },
        "description": { "type": "string" },
        "originalAmount": { "type": "number" },
        "issueDate": { "type": "string", "format": "date" },
        "dueDate": { "type": "string", "format": "date" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["Open", "Paid", "Overdue"] },
        "paymentDate": { "type": "string", "format": "date" },
        "bankAccountId": { "type": "string" },
        "interest": { "type": "number" },
        "fine": { "type": "number" },
        "discount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "supplierId", "accountCategoryId", "description", "originalAmount", "dueDate", "status", "createdAt", "updatedAt"]
    },
    "AccountsReceivableEntry": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AccountsReceivableEntry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "accountCategoryId": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "dueDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["Open", "Paid"] },
        "paymentDate": { "type": "string", "format": "date" },
        "bankAccountId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerName", "accountCategoryId", "description", "amount", "dueDate", "status", "createdAt", "updatedAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}/suppliers/{supplierId}",
        "definition": {
          "entityName": "Supplier",
          "schema": { "$ref": "#/backend/entities/Supplier" },
          "description": "Stores supplier records."
        }
      },
      {
        "path": "/users/{userId}/accountCategories/{categoryId}",
        "definition": {
          "entityName": "AccountCategory",
          "schema": { "$ref": "#/backend/entities/AccountCategory" },
          "description": "Stores account categories."
        }
      },
      {
        "path": "/users/{userId}/costCenters/{centerId}",
        "definition": {
          "entityName": "CostCenter",
          "schema": { "$ref": "#/backend/entities/CostCenter" },
          "description": "Stores cost centers."
        }
      },
      {
        "path": "/users/{userId}/accountsPayableEntries/{entryId}",
        "definition": {
          "entityName": "AccountsPayableEntry",
          "schema": { "$ref": "#/backend/entities/AccountsPayableEntry" },
          "description": "Stores accounts payable entries."
        }
      },
      {
        "path": "/users/{userId}/accountsReceivableEntries/{entryId}",
        "definition": {
          "entityName": "AccountsReceivableEntry",
          "schema": { "$ref": "#/backend/entities/AccountsReceivableEntry" },
          "description": "Stores accounts receivable entries."
        }
      }
    ]
  }
}
