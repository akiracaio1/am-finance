
{
  "entities": {
    "Supplier": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Supplier",
      "type": "object",
      "description": "Represents a vendor or supplier with whom the business conducts transactions.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "personType": { "type": "string", "enum": ["Pessoa Física", "Pessoa Jurídica"] },
        "pixKey": { "type": "string" },
        "cnpj": { "type": "string" },
        "contactName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "category": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "personType", "createdAt", "updatedAt"]
    },
    "AccountCategory": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AccountCategory",
      "type": "object",
      "description": "Defines a category within the chart of accounts.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string" },
        "code": { "type": "string" },
        "parentCategoryId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "type", "createdAt", "updatedAt"]
    },
    "CostCenterGroup": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CostCenterGroup",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "parentGroupId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "CostCenter": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CostCenter",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Archived"] },
        "archivedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "name", "status", "createdAt", "updatedAt"]
    },
    "AccountsPayableEntry": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AccountsPayableEntry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "supplierId": { "type": "string" },
        "accountCategoryId": { "type": "string" },
        "costCenterId": { "type": "string" },
        "description": { "type": "string" },
        "originalAmount": { "type": "number" },
        "issueDate": { "type": "string", "format": "date" },
        "dueDate": { "type": "string", "format": "date" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["Open", "Paid", "Overdue", "DueToday"] },
        "entryType": { "type": "string", "enum": ["Provision", "Confirmed"] },
        "paymentDate": { "type": "string", "format": "date" },
        "bankAccountId": { "type": "string" },
        "interest": { "type": "number" },
        "fine": { "type": "number" },
        "discount": { "type": "number" },
        "installmentInfo": { "type": "string" },
        "rootEntryId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "supplierId", "accountCategoryId", "description", "originalAmount", "issueDate", "dueDate", "status", "entryType", "createdAt", "updatedAt"]
    },
    "AccountsReceivableEntry": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AccountsReceivableEntry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "accountCategoryId": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "issueDate": { "type": "string", "format": "date" },
        "dueDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["Open", "Paid"] },
        "paymentDate": { "type": "string", "format": "date" },
        "bankAccountId": { "type": "string" },
        "rootEntryId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerName", "accountCategoryId", "description", "amount", "issueDate", "dueDate", "status", "createdAt", "updatedAt"]
    },
    "BankAccount": {
      "title": "BankAccount",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "bank": { "type": "string" },
        "type": { "type": "string", "enum": ["Corrente", "Poupança", "Investimento", "Caixinha"] },
        "initialBalance": { "type": "number" },
        "openingDate": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "bank", "type", "initialBalance", "openingDate"]
    },
    "BankTransaction": {
      "title": "BankTransaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["CREDIT", "DEBIT"] },
        "reconciled": { "type": "boolean" },
        "reconciledEntryId": { "type": "string" },
        "fitId": { "type": "string" },
        "bankAccountId": { "type": "string" },
        "ignored": { "type": "boolean" }
      },
      "required": ["id", "date", "amount", "description", "type", "reconciled"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "action": { "type": "string", "enum": ["CREATE", "UPDATE", "DELETE"] },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "action", "entityType", "timestamp"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}/suppliers/{supplierId}",
        "definition": {
          "entityName": "Supplier",
          "schema": { "$ref": "#/backend/entities/Supplier" },
          "description": "Stores supplier records."
        }
      },
      {
        "path": "/users/{userId}/accountCategories/{categoryId}",
        "definition": {
          "entityName": "AccountCategory",
          "schema": { "$ref": "#/backend/entities/AccountCategory" },
          "description": "Stores account categories."
        }
      },
      {
        "path": "/users/{userId}/costCenterGroups/{groupId}",
        "definition": {
          "entityName": "CostCenterGroup",
          "schema": { "$ref": "#/backend/entities/CostCenterGroup" },
          "description": "Stores groups of cost centers."
        }
      },
      {
        "path": "/users/{userId}/costCenters/{centerId}",
        "definition": {
          "entityName": "CostCenter",
          "schema": { "$ref": "#/backend/entities/CostCenter" },
          "description": "Stores cost centers."
        }
      },
      {
        "path": "/users/{userId}/accountsPayableEntries/{entryId}",
        "definition": {
          "entityName": "AccountsPayableEntry",
          "schema": { "$ref": "#/backend/entities/AccountsPayableEntry" },
          "description": "Stores accounts payable entries."
        }
      },
      {
        "path": "/users/{userId}/accountsReceivableEntries/{entryId}",
        "definition": {
          "entityName": "AccountsReceivableEntry",
          "schema": { "$ref": "#/backend/entities/AccountsReceivableEntry" },
          "description": "Stores accounts receivable entries."
        }
      },
      {
        "path": "/users/{userId}/bankAccounts/{bankAccountId}",
        "definition": {
          "entityName": "BankAccount",
          "schema": { "$ref": "#/backend/entities/BankAccount" },
          "description": "Bank account metadata."
        }
      },
      {
        "path": "/users/{userId}/bankAccounts/{bankAccountId}/bankTransactions/{transactionId}",
        "definition": {
          "entityName": "BankTransaction",
          "schema": { "$ref": "#/backend/entities/BankTransaction" },
          "description": "Bank transactions imported from OFX."
        }
      },
      {
        "path": "/users/{userId}/auditLogs/{logId}",
        "definition": {
          "entityName": "AuditLog",
          "schema": { "$ref": "#/backend/entities/AuditLog" },
          "description": "Stores activity logs for auditing."
        }
      }
    ]
  }
}
