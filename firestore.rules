rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * AM Finance - Security Rules
     *
     * CORE PHILOSOPHY:
     * Strict path-based ownership. Data is segregated by user or company.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    /** Rules for User Profiles and Company associations */
    match /users/{userId} {
      allow get, write: if isOwner(userId);
    }

    /** Rules for Companies */
    match /companies/{companyId} {
      allow create: if isSignedIn();
      allow get, update: if isSignedIn(); // In a real app, we'd check if user belongs to company
    }

    /** Rules for Supplier records nested under users */
    match /users/{userId}/suppliers/{supplierId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == supplierId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);
    }

    /** Rules for Account Categories */
    match /users/{userId}/accountCategories/{categoryId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == categoryId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);
    }

    /** Rules for Cost Centers */
    match /users/{userId}/costCenters/{centerId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == centerId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);
    }

    /** Rules for Bank Accounts and Transactions */
    match /users/{userId}/bankAccounts/{bankAccountId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == bankAccountId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);

      match /bankTransactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.id == transactionId;
        allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
        allow delete: if isOwner(userId);
      }
    }

    /** Rules for Financial Entries (Payable/Receivable) */
    match /users/{userId}/accountsPayableEntries/{entryId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == entryId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/accountsReceivableEntries/{entryId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == entryId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);
    }

    /** Rules for Cash Flow Projections */
    match /users/{userId}/cashFlowProjections/{projectionId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == projectionId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);
    }
  }
}