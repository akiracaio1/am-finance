
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get, write: if isOwner(userId);

      match /suppliers/{supplierId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.id == supplierId;
        allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
        allow delete: if isOwner(userId);
      }

      match /accountCategories/{categoryId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.id == categoryId;
        allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
        allow delete: if isOwner(userId);
      }

      match /costCenterGroups/{groupId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.id == groupId;
        allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
        allow delete: if isOwner(userId);
      }

      match /costCenters/{centerId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.id == centerId;
        allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
        allow delete: if isOwner(userId);
      }

      match /bankAccounts/{bankAccountId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.id == bankAccountId;
        allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
        allow delete: if isOwner(userId);

        match /bankTransactions/{transactionId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && request.resource.data.id == transactionId;
          allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
          allow delete: if isOwner(userId);
        }
      }

      match /manualForecasts/{forecastId} {
        allow get, list, write: if isOwner(userId);
      }

      match /accountsPayableEntries/{entryId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.id == entryId;
        allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
        allow delete: if isOwner(userId);
      }

      match /accountsReceivableEntries/{entryId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.id == entryId;
        allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
        allow delete: if isOwner(userId);
      }

      match /auditLogs/{logId} {
        allow get, list, write: if isOwner(userId);
      }
    }

    match /companies/{companyId} {
      allow create: if isSignedIn();
      allow get, update: if isSignedIn();
    }
  }
}
