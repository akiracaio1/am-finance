
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares para verificações comuns
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Regras para dados específicos do usuário
    match /users/{userId} {
      // Permite que o dono gerencie seu próprio documento de perfil
      allow get, write: if isOwner(userId);

      // Regras para subcoleções (Dono tem acesso total de leitura e escrita)
      
      match /suppliers/{supplierId} {
        allow read, write: if isOwner(userId);
      }

      match /accountCategories/{categoryId} {
        allow read, write: if isOwner(userId);
      }

      match /costCenterGroups/{groupId} {
        allow read, write: if isOwner(userId);
      }

      match /costCenters/{centerId} {
        allow read, write: if isOwner(userId);
      }

      match /bankAccounts/{bankAccountId} {
        allow read, write: if isOwner(userId);

        match /bankTransactions/{transactionId} {
          allow read, write: if isOwner(userId);
        }
        
        // Regras para marcação de dias sem movimento (Conciliação)
        match /noMovementDays/{dayId} {
          allow read, write: if isOwner(userId);
        }
      }

      // Regras para o módulo de Planejamento / Forecast
      match /manualForecasts/{forecastId} {
        allow read, write: if isOwner(userId);
      }

      match /accountsPayableEntries/{entryId} {
        allow read, write: if isOwner(userId);
      }

      match /accountsReceivableEntries/{entryId} {
        allow read, write: if isOwner(userId);
      }

      // Regras para Logs de Auditoria
      match /auditLogs/{logId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Regras para perfis de empresas (usado no cadastro)
    match /companies/{companyId} {
      allow create: if isSignedIn();
      allow get, update: if isSignedIn();
    }
  }
}
